<header class="top" id="top"><div class="w">
  <a class="logo" href="{{ logo_href or '#start' }}"><img src="{{ root }}logo.svg" alt="Wyniosę" width="146" height="35"></a>
  <nav aria-label="{{ t.nav_label }}"><ul>
    <li><a href="{{ home }}#ceny">{{ t.nav_prices }}</a></li><li><a href="{{ home }}#uslugi">{{ t.nav_services }}</a></li><li><a href="{{ home }}#pszok">PSZOK</a></li><li><a href="{{ home }}#wycena">{{ t.nav_quote }}</a></li><li><a href="{{ home }}#o-nas">{{ t.nav_about }}</a></li>
  </ul></nav>
  <div class="langs-nav" aria-label="{{ t.lang_label }}">
    {%- for code, label, href, name in langs %}
    <a href="{{ href }}" hreflang="{{ code }}" lang="{{ code }}" title="{{ name }}"{% if code == lang %} aria-current="page"{% endif %}>{{ label }}</a>
    {%- endfor %}
  </div>
  <a class="hdr-tel js-call num js-phone" href="{{ c.tel or '#kontakt' }}">{{ c.phone or '+48 ··· ··· ···' }}</a>
  <a class="btn sm hdr-cta js-wa" href="{{ home }}#wycena">WhatsApp</a>
</div></header>
